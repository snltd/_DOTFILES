<?xml version="1.0"?>
<labwc_config>
  <desktops>
    <popupTime>1000</popupTime>
    <names>
      <name>1</name>
      <name>2</name>
      <name>3</name>
      <name>4</name>
    </names>
  </desktops>
  <focus followMouse="yes"> </focus>
  <keyboard>
    <default/>
    <keybind key="W-Space">
      <action name="Execute">
        <command>rofi -show run</command>
      </action>
    </keybind>
    <keybind key="W-b">
      <action name="Execute">
        <command>wezterm ssh serv-build</command>
      </action>
    </keybind>
    <keybind key="Pause">
      <action name="Execute">
        <command>kitty</command>
      </action>
    </keybind>
    <keybind key="C-A-Left">
      <action name="GoToDesktop" to="left"/>
    </keybind>
    <keybind key="C-A-Right">
      <action name="GoToDesktop" to="right"/>
    </keybind>
    <keybind key="Print">
      <action name="Execute">
        <command>sh -c 'grim ~/downloads/screenshot-$(date +%Y%m%d-%H%M%S).png'</command>
      </action>
    </keybind>
    <keybind key="S-Print">
      <action name="Execute">
        <command>sh -c 'grim -g "$(slurp)" ~/downloads/screenshot-$(date +%Y%m%d-%H%M%S).png'</command>
      </action>
    </keybind>
    <keybind key="W-1">
      <action name="SendToDesktop" to="1"/>
    </keybind>
    <keybind key="W-2">
      <action name="SendToDesktop" to="2"/>
    </keybind>
    <keybind key="W-3">
      <action name="SendToDesktop" to="3"/>
    </keybind>
    <keybind key="W-4">
      <action name="SendToDesktop" to="4"/>
    </keybind>
  </keyboard>
  <mouse>
    <default/>
    <context name="Title">
      <mousebind button="Left" action="DoubleClick">
        <action name="ToggleMaximize" direction="vertical"/>
      </mousebind>
    </context>
  </mouse>
  <theme>
    <font place="ActiveWindow">
      <name>Roboto</name>
      <size>13</size>
      <slant>normal</slant>
      <weight>normal</weight>
    </font>
    <font place="InactiveWindow">
      <name>Roboto</name>
      <size>13</size>
      <slant>normal</slant>
      <weight>normal</weight>
    </font>
  </theme>
</labwc_config>
