{
  "layer": "top",
  "modules-left": ["ext/workspaces", "systemd-failed-units"],
  "modules-center": [],
  "modules-right": ["pulseaudio", "clock"],
  "clock": {
    "format": "{:%a %d %b %H:%M}"
  },
  "pulseaudio": {
    "format": "{volume}% {icon}",
    "format-bluetooth": "{volume}% {icon}",
    "format-muted": "",
    "format-icons": {
      "alsa_output.pci-0000_00_1f.3.analog-stereo": "",
      "alsa_output.pci-0000_00_1f.3.analog-stereo-muted": "",
      "headphone": "",
      "hands-free": "󰂑",
      "headset": "󰂑",
      "phone": "",
      "phone-muted": "",
      "portable": "",
      "car": "",
      "default": ["", ""]
    },
    "scroll-step": 1,
    "on-click": "pavucontrol"
  },
  "ext/workspaces": {
    "format": "{name}",
    "on-click": "activate",
    "sort-by-id": true
  },
  "systemd-failed-units": {
    "hide-on-ok": false,
    "format": "✗ {nr_failed}",
    "format-ok": "✓",
    "system": true,
    "user": false,
    "tooltip-format": "{nr_failed} failed units:n{failed_units_list}",
    "tooltip-unit-format": "{scope}: {name} ({active_state})"
  }
}
